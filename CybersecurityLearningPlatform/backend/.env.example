# ==========================================================================
#  CybersecurityLearningPlatform backend 環境變數範本
#  複製為 .env 後填入實際值（.env 已 gitignore，勿提交真實金鑰）。
# ==========================================================================

# --- Flask 設定 ---
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
SHOW_DEBUG_ANSWERS=false

# --- LLM 提供者 (openai / groq / lm_studio / nvidia) ---
LLM_PROVIDER=lm_studio
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- OpenAI（LLM_PROVIDER=openai 時使用）---
OPENAI_API_KEY=

# --- Groq（LLM_PROVIDER=groq 與部分實驗腳本使用）---
GROQ_MODEL=llama3-70b-8192
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# --- LM Studio（本機推論 / embedding）---
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=openai/gpt-oss-20b
LM_STUDIO_CHAT_URL=http://127.0.0.1:1234/v1/chat/completions
LM_STUDIO_CHAT_URL_ALT=http://127.0.0.1:1234/v1/chat/completions
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1

# --- NVIDIA NIM（Llama-70B；LLM_PROVIDER=nvidia 與驗證/實驗腳本）---
# 動態掃描 NVIDIA_API_KEY_<N>：有幾把用幾把、worker 數等比；編號可增減、可跳號。
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
# ...依需要續加 NVIDIA_API_KEY_4、NVIDIA_API_KEY_5 ...

# --- Google AI Studio / Gemini（Gemma；ETL 萃取 02 + 實驗三 Graph RAG）---
# 優先且唯一來源：多把金鑰以逗號分隔集中於此，程式自動 round-robin。
# 格式範例：GEMINI_API_KEYS=AIzaXXXX,AIzaYYYY,AQ.ZZZZ
GEMINI_API_KEYS=
# 選填 fallback（單把；已填 GEMINI_API_KEYS 時免填，程式仍支援）：
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Neo4j 資料庫 ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- 資料路徑 ---
SOURCE_DATA_DIR=SourceData
CHUNKS_DIR=Chunks

# --- 9router gateway（gemma routing 已於 2026-07-12 退役，保留備援）---
NINEROUTER_URL=
NINEROUTER_KEY=
